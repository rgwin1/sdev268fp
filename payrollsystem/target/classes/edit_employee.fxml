<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>

<!-- add employee screen layout -->
<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.payrollsystem.controllers.EditEmployeeController">

   <!-- input fields for employee details -->
    <TextField fx:id="firstNameField" promptText="First Name"/>
    <TextField fx:id="lastNameField" promptText="Last Name"/>
    <TextField fx:id="middleNameField" promptText="Middle Name"/>
    <TextField fx:id="dobField" promptText="Date of Birth (YYYY-MM-DD)"/>
    <TextField fx:id="phoneField" promptText="Phone Number"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <TextField fx:id="jobTitleField" promptText="Job Title"/>
    <TextField fx:id="wageField" promptText="Hourly Wage"/>

    <!-- New required fields -->
    <ComboBox fx:id="statusField" promptText="Status">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Active"/>
                <String fx:value="Terminated"/>
            </FXCollections>
        </items>
    </ComboBox>

    <ComboBox fx:id="genderField" promptText="Gender">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Male"/>
                <String fx:value="Female"/>
            </FXCollections>
        </items>
    </ComboBox>

    <ComboBox fx:id="payTypeField" promptText="Pay Type">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Hourly"/>
                <String fx:value="Salary"/>
            </FXCollections>
        </items>
    </ComboBox>
    
    <ComboBox fx:id="roleField" promptText="Role">
    <items>
        <FXCollections fx:factory="observableArrayList">
            <String fx:value="employee"/>
            <String fx:value="admin"/>
        </FXCollections>
    </items>
</ComboBox>
<Label text="Medical Coverage"/>
<ComboBox fx:id="coverageField" prefWidth="150">
    <items>
        <FXCollections fx:factory="observableArrayList">
            <String fx:value="Single"/>
            <String fx:value="Family"/>
        </FXCollections>
    </items>
</ComboBox>

<Label text="Number of Dependents"/>
<TextField fx:id="dependentsField" promptText="e.g. 2"/>

<Label text="Department"/>
<TextField fx:id="departmentField" promptText="e.g. HR"/>

<Label text="Hire Date (YYYY-MM-DD)"/>
<TextField fx:id="hireDateField" promptText="2025-08-05"/>




    <TextField fx:id="addressLine1Field" promptText="Address Line 1"/>
    <TextField fx:id="addressLine2Field" promptText="Address Line 2 (optional)"/>
    <TextField fx:id="cityField" promptText="City"/>
    <TextField fx:id="stateField" promptText="State"/>
    <TextField fx:id="zipField" promptText="ZIP Code"/>


    <!-- submit button and status label -->
    <Button fx:id="updateButton" text="Update Employee" onAction="#onUpdateEmployeeClick" />
    <Button fx:id="backButton" text="Back to Dashboard"  onAction="#onBackClick"/>
    <Label fx:id="statusLabel" textFill="green"/>
</VBox>
